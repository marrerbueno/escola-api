# Banco de Dados
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/escola_db"

# JWT
JWT_SECRET="sua-chave-secreta-super-segura-aqui-mude-em-producao"
JWT_EXPIRES_IN="24h"

# Servidor
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:3000"

# ============================================
# WHATSAPP - Configuração do Provedor
# ============================================
# Opções: twilio, evolution, zapi, mock (desenvolvimento)
WHATSAPP_PROVIDER="mock"

# ============================================
# TWILIO (https://www.twilio.com)
# ============================================
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER="+1234567890"

# ============================================
# EVOLUTION API (https://doc.evolution-api.com)
# Gratuito, self-hosted
# ============================================
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_API_INSTANCE="escola"

# ============================================
# Z-API (https://z-api.io)
# Gratuito com limites
# ============================================
ZAPI_INSTANCE_ID=""
ZAPI_TOKEN=""
